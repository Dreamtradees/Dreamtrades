# Optional overrides for post-checklist graduation join links.
# If unset, empty links show “coming soon” until you set these.
NEXT_PUBLIC_TELEGRAM_VIP_URL=
NEXT_PUBLIC_WHATSAPP_GROUP_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Graduation completions (server-only) ---
#
# Minimum to accept claims + DM you on Telegram:
#   TELEGRAM_BOT_TOKEN + TELEGRAM_OWNER_CHAT_ID + ADMIN_SECRET
# Strongly recommended so leads survive cold starts:
#   UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
ADMIN_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local/dev only:
# COMPLETIONS_ALLOW_MEMORY=1
# TELEGRAM_NOTIFY_MOCK=1
# COMPLETIONS_USE_FILE=1
