# --- Graduation completions (server-only; required for the claim form to work) ---
# Create a bot with @BotFather, then DM that bot from your personal Telegram account.
# TELEGRAM_OWNER_CHAT_ID is your numeric user id (e.g. from @userinfobot or a /whoami helper).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Protects /admin/completions?key=... and GET /api/completions?key=...
ADMIN_SECRET=

# Optional durable counter + recent graduate list (free Upstash Redis REST).
# Without these, Telegram DMs still work; the admin count is in-memory only (resets on cold starts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
