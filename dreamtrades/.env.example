# Optional overrides for post-checklist graduation join links.
# If unset, DreamTrades uses the named constants in src/lib/site.ts.
NEXT_PUBLIC_TELEGRAM_VIP_URL=https://t.me/+BMI1xqg1TDwyYmQ8
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/JP4a2T2bpi17mdneoLVoUN?mode=gi_t
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/GYNqdFz6g
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/zhabii7_fx/

# --- Graduation completions (server-only) — required on Vercel for live claims ---
#
# Minimum to accept claims + DM you on Telegram:
#   TELEGRAM_BOT_TOKEN + TELEGRAM_OWNER_CHAT_ID + ADMIN_SECRET
# Strongly recommended so leads survive cold starts:
#   UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#
# Create a bot with @BotFather, then open that bot and press Start.
# TELEGRAM_OWNER_CHAT_ID = your numeric user id
#   easiest: message @userinfobot → copy "Id"
#   or: set TELEGRAM_BOT_TOKEN, message your bot, then
#       GET /api/completions/telegram-setup?key=ADMIN_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Protects /admin/completions?key=... and admin API routes.
# Use a long random string (e.g. openssl rand -hex 24).
ADMIN_SECRET=

# Affiliate partner portal keys (optional).
# Pattern: AFFILIATE_<SLUG>_SECRET — e.g. slug "sara" → AFFILIATE_SARA_SECRET
# Her CRM: /partners/sara?key=…
AFFILIATE_SARA_SECRET=
# Sara team admin — sees ALL leads at /admin/completions?key=…
AFFILIATE_SARA_ADMIN_SECRET=

# Durable graduate count + lead list (strongly recommended for Vercel).
# Free Upstash Redis REST — see README “Upstash free setup”.
# Vercel Marketplace / Vercel KV aliases also work:
#   KV_REST_API_URL / KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local/dev only:
# COMPLETIONS_ALLOW_MEMORY=1   — accept claims without Telegram/Redis
# TELEGRAM_NOTIFY_MOCK=1       — log DMs to the server console instead of Telegram
# COMPLETIONS_USE_FILE=1       — force .data/completions.json file store
# COMPLETIONS_FILE_PATH=       — optional absolute path override for file store
