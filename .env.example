# Required for live Telegram connection (from @BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID.
# Easiest: start the bot with TELEGRAM_BOT_TOKEN set, send /whoami, paste the number here.
# Alternatives if needed: @RawDataBot or @getidsbot ( @userinfobot is often unresponsive ).
# Comma-separated allowlist; leave empty only for local mock demos.
TELEGRAM_ALLOWED_USER_IDS=

# Cursor Cloud Agents API key (Dashboard → API Keys)
CURSOR_API_KEY=

# Default GitHub repo the bot launches agents against
CURSOR_DEFAULT_REPO=https://github.com/your-org/your-repo

# Optional branch / model defaults
CURSOR_DEFAULT_REF=main
CURSOR_DEFAULT_MODEL=

# Server
PORT=43127
HOST=0.0.0.0

# Set to 1 to force mock mode even if tokens are present
MOCK_MODE=0

# TradingView alert webhooks (not full account login)
# Auto-generated if missing. Put this URL into TradingView Alert → Webhook URL.
TRADINGVIEW_WEBHOOK_SECRET=
# Public HTTPS base URL. If empty, the server tries to open a localtunnel automatically.
PUBLIC_BASE_URL=
